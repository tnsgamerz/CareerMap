// ─── src/AuthScreen.jsx ───────────────────────────────────────────────────────
// Real Google Sign-In using Firebase Auth + Google OAuth.
// Works on any deployed domain (Vercel, Firebase Hosting, Netlify).
// ─────────────────────────────────────────────────────────────────────────────

import { useState } from "react";
import { signInWithGoogle } from "./firebase";

// Paste your logo base64 here or use an img src path
// import LOGO_SRC from "./assets/logo.png";
const LOGO_SRC = "./logo.png"; // put your logo in /public/logo.png

const FEATS = [
  ["📅", "Month-by-month roadmap"],
  ["🎯", "Skill matrix & tools"],
  ["💰", "Global salary data"],
  ["🏢", "Top companies & certs"],
];

export default function AuthScreen({ onLogin }) {
  const [loading, setLoading] = useState(false);
  const [error,   setError]   = useState("");

  async function handleGoogleLogin() {
    setLoading(true);
    setError("");
    try {
      const firebaseUser = await signInWithGoogle();
      // Pass normalized user object to parent
      onLogin({
        name:    firebaseUser.displayName || firebaseUser.email,
        email:   firebaseUser.email,
        picture: firebaseUser.photoURL || "",
        sub:     firebaseUser.uid,          // Firebase UID — unique, stable
        uid:     firebaseUser.uid,
      });
    } catch (e) {
      if (e.code === "auth/popup-closed-by-user") {
        setError("Sign-in cancelled. Please try again.");
      } else if (e.code === "auth/popup-blocked") {
        setError("Popup blocked! Please allow popups for this site and try again.");
      } else {
        setError(e.message || "Sign-in failed. Please try again.");
      }
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="auth-overlay">
      <div className="auth-wrap">

        {/* LEFT — Branding */}
        <div className="auth-left">
          <img src={LOGO_SRC} alt="CareerMap" className="auth-logo-img" />
          <div className="auth-brand">Career<em>Map</em></div>
          <div className="auth-tagline">Your Path. Your Future.</div>
          <div className="auth-features">
            {FEATS.map(([icon, txt]) => (
              <div key={txt} className="auth-feature">
                <span className="auth-feat-icon">{icon}</span>{txt}
              </div>
            ))}
          </div>
        </div>

        {/* RIGHT — Sign in */}
        <div className="auth-right">
          <div className="auth-title">Welcome to CareerMap</div>
          <div className="auth-sub">
            Sign in with your Google account to generate personalized
            career roadmaps, salary benchmarks, and more.
          </div>

          {error && <div className="auth-err">⚠️ {error}</div>}

          {/* Real Google Sign-In Button */}
          <button
            className="auth-google-btn"
            onClick={handleGoogleLogin}
            disabled={loading}
          >
            {loading ? (
              <>
                <span className="auth-spinner" />
                Signing in…
              </>
            ) : (
              <>
                {/* Official Google G logo */}
                <svg width="20" height="20" viewBox="0 0 48 48" style={{ flexShrink: 0 }}>
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                Continue with Google
              </>
            )}
          </button>

          <p className="auth-terms">
            By continuing you agree to our{" "}
            <a href="/privacy" style={{ color: "var(--p3)", textDecoration: "none" }}>
              Privacy Policy
            </a>{" "}
            and{" "}
            <a href="/terms" style={{ color: "var(--p3)", textDecoration: "none" }}>
              Terms of Service
            </a>
            .<br />
            We only access your name, email, and profile photo.
          </p>
        </div>
      </div>
    </div>
  );
}
